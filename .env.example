# Copy to .env.local. With nothing set, the app runs in demo mode with sample data.

# Supabase → Project Settings → API. The URL and anon key are public; row-level security protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for account deletion (required by the App Store).
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Raises Google Books quota; search works without it.
GOOGLE_BOOKS_API_KEY=

# The deployed site the iOS app loads (e.g. https://bookclub.vercel.app).
CAP_SERVER_URL=
