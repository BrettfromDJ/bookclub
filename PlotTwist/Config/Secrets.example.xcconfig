// Copy this file to Secrets.xcconfig (same folder) and fill it in.
// Supabase → Project Settings → API. Both values are safe to ship in the app;
// row-level security protects the data.

// Host only, no https:// (xcconfig files treat // as a comment).
SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-key

// Optional. Raises the Google Books search quota.
GOOGLE_BOOKS_API_KEY =

// Your Apple developer team ID (Xcode → Settings → Accounts), so you don't have to pick it each time.
// DEVELOPMENT_TEAM = ABCDE12345
